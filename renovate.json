{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigestsToSemver"],
  "semanticCommits": "enabled",
  "prHourlyLimit": 0,
  "devcontainer": {
    "managerFilePatterns": ["/^images/[^/]+/devcontainer\\.json$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "The zizmor version the zizmor workflow runs",
      "managerFilePatterns": ["/^\\.github/workflows/zizmor\\.yml$/"],
      "matchStrings": ["\\n\\s+version: (?<currentValue>\\d+\\.\\d+\\.\\d+)\\n"],
      "depNameTemplate": "zizmor",
      "datasourceTemplate": "pypi"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["devcontainer"],
      "postUpgradeTasks": {
        "commands": [
          "npm ci --ignore-scripts",
          "npx devcontainer upgrade --workspace-folder . --config {{{packageFile}}}"
        ],
        "fileFilters": ["**/devcontainer-lock.json"],
        "executionMode": "update",
        "installTools": { "node": {} }
      }
    },
    {
      "matchFileNames": ["images/**"],
      "semanticCommitType": "fix"
    },
    {
      "matchFileNames": ["images/**"],
      "matchUpdateTypes": ["major"],
      "semanticCommitType": "feat"
    }
  ]
}
