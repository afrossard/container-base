{
  "name": "container-base",
  "build": {
    "dockerfile": "Containerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    }
  },
  "remoteEnv": {
    "DOTFILES_REPO": "${localEnv:DOTFILES_REPO}"
  },
  "postCreateCommand": "${containerWorkspaceFolder}/.devcontainer/post-create",
  "postStartCommand": "${containerWorkspaceFolder}/.devcontainer/post-start",
  // Default (updateContentCommand, undefined here) lets VS Code open the
  // first integrated terminal before dotfiles-bootstrap finishes cloning
  // and applying - that terminal sources .zshrc before it exists and
  // stays bare for its lifetime. postStartCommand waits for the bootstrap
  // to complete first.
  "waitFor": "postStartCommand",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "EditorConfig.EditorConfig",
        "esbenp.prettier-vscode",
        "ms-azuretools.vscode-containers",
        "charliermarsh.ruff",
        "eamodio.gitlens",
        "mhutchie.git-graph",
        "donjayamanne.githistory"
      ]
    }
  }
}
