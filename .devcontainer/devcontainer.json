{
  "name": "container-base",
  "build": {
    "dockerfile": "Containerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1.10.3": {
      "moby": false
    }
  },
  // The dev image ships the shared lifecycle through its
  // devcontainer.metadata label (images/dev/devcontainer.json, ADR-0029),
  // so the reference profile keeps only its own additions, which run after
  // the image's.
  "postCreateCommand": "npm ci",
  "customizations": {
    "vscode": {
      "extensions": ["charliermarsh.ruff"]
    }
  }
}
