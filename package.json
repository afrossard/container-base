{
  "name": "container-base",
  "version": "0.0.0",
  "private": true,
  "description": "Tooling-only manifest: prettier formatting for this repo's Markdown, JSON and YAML, and the devcontainer CLI that builds the images. No runtime JavaScript.",
  "config": {
    "devImage": "container-base:dev-test",
    "agentImage": "container-base:agent-test"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "build:dev": "devcontainer build --workspace-folder . --config images/dev/devcontainer.json --frozen-lockfile --image-name $npm_package_config_devImage",
    "test:dev": "IMAGE=$npm_package_config_devImage bats --print-output-on-failure test/dev",
    "publish:dev": "devcontainer build --workspace-folder . --config images/dev/devcontainer.json --frozen-lockfile --platform linux/amd64,linux/arm64 --push --image-name $IMAGE",
    "verify:publish-dev": "bats --print-output-on-failure test/publish-dev",
    "tag:agent-base": ".github/scripts/tag-agent-base.sh $npm_package_config_devImage images/agent/Containerfile",
    "build:agent": "devcontainer build --workspace-folder . --config images/agent/devcontainer.json --frozen-lockfile --image-name $npm_package_config_agentImage",
    "test:agent": "IMAGE=$npm_package_config_agentImage bats --print-output-on-failure test/agent",
    "publish:agent": "devcontainer build --workspace-folder . --config images/agent/devcontainer.json --frozen-lockfile --platform linux/amd64,linux/arm64 --push --image-name $IMAGE",
    "verify:publish-agent": "bats --print-output-on-failure test/publish-agent",
    "test:launcher": "bats --print-output-on-failure test/launcher",
    "test:cleanup": "bats --print-output-on-failure test/cleanup",
    "test:scripts": "bats --print-output-on-failure test/scripts"
  },
  "devDependencies": {
    "@devcontainers/cli": "^0.90.0",
    "bats": "^1.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.1",
    "prettier": "^3.9.6"
  },
  "lint-staged": {
    "*.{md,json,jsonc,yaml,yml,html}": "prettier --check"
  }
}
