#!/usr/bin/env bash
# Removes one explicitly named agent-runtime sandbox and its paired
# <name>-docker-data volume.
#
# Usage:
#   scripts/cleanup-agent-sessions --name SESSION [--dry-run] [--force]
#
# Under the pet model (ADR-0021) a stopped runtime is a normal state, not
# litter, so --name is required and there is no bulk sweep. Destroying this
# repo's runtime is otherwise the launcher's job: the only destruction path
# is `launch-agent-runtime --reset`, which also removes the docker volume.
#
#   --name SESSION   the only thing this removes: this one sandbox and its
#                    volume, running or not (running requires --force too)
#   --dry-run        list what would be removed, without removing anything
#   --force          skip the confirmation prompt; also required to
#                    remove a running sandbox

set -eo pipefail

# shellcheck source=lib/agent-runtime.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/agent-runtime.sh"

dry_run=0
force=0
target_name=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --name)
      target_name="$2"
      shift 2
      ;;
    --dry-run)
      dry_run=1
      shift
      ;;
    --force)
      force=1
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      echo "cleanup-agent-sessions: unrecognized argument: $1" >&2
      usage
      exit 1
      ;;
  esac
done

# After the parse loop, so --help works without them.
require_tools msb git

if [ -z "$target_name" ]; then
  echo "cleanup-agent-sessions: name the runtime to remove with --name SESSION." >&2
  echo "cleanup-agent-sessions: a stopped runtime is a normal state under the pet model (ADR-0021), not litter - there is no bulk cleanup. To destroy this repo's runtime, use 'launch-agent-runtime --reset'." >&2
  exit 1
fi

if ! sandbox_exists "$target_name"; then
  echo "cleanup-agent-sessions: no sandbox named '$target_name'" >&2
  exit 1
fi
if sandbox_is_running "$target_name" && [ "$force" != "1" ]; then
  echo "cleanup-agent-sessions: '$target_name' is currently running; pass --force to remove it anyway" >&2
  exit 1
fi

echo "cleanup-agent-sessions: sandbox to remove:" >&2
printf '  %s\n' "$target_name" >&2

if [ "$dry_run" = "1" ]; then
  echo "cleanup-agent-sessions: --dry-run, nothing removed" >&2
  exit 0
fi

confirm_or_die "Remove '$target_name' and its volume? [y/N] " "$force"

remove_runtime "$target_name"
