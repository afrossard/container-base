#!/usr/bin/env bash
# Housekeeping for this repo's agent runtimes: list them, or remove the
# ones you are finished with along with their paired <name>-docker-data
# volumes. It acts only on runtimes labelled for this repo.
#
# Usage:
#   scripts/cleanup-agent-sessions [--name SESSION | --all] [--dry-run] [--force]
#
# With neither --name nor --all it only lists this repo's runtimes and
# their state, removing nothing. A stopped runtime is a normal parked
# state, so removal is never implicit: you name one, or ask for --all.
#
#   (no args)        list this repo's runtimes, each marked running,
#                    stopped, or unknown; remove nothing
#   --name SESSION   remove this one runtime and its volume; a runtime
#                    that is not stopped needs --force too
#   --all            remove this repo's stopped runtimes and their
#                    volumes; --force extends it to running ones too
#   --dry-run        list what --name / --all would remove, remove nothing
#   --force          skip the confirmation prompt, and remove a runtime
#                    that --name or --all would otherwise keep

set -eo pipefail

# shellcheck source=lib/agent-runtime.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/agent-runtime.sh"

dry_run=0
force=0
all=0
target_name=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --name)
      target_name="$2"
      shift 2
      ;;
    --all)
      all=1
      shift
      ;;
    --dry-run)
      dry_run=1
      shift
      ;;
    --force)
      force=1
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      echo "cleanup-agent-sessions: unrecognized argument: $1" >&2
      usage
      exit 1
      ;;
  esac
done

# After the parse loop, so --help works without them.
require_tools msb git

if [ -n "$target_name" ] && [ "$all" = "1" ]; then
  echo "cleanup-agent-sessions: give --name or --all, not both" >&2
  exit 1
fi

# This repo's runtimes only (the `repo=<repo>` label set): a bare call
# lists them, --name acts on one of them, --all on the batch. A --name
# outside this set is refused rather than reaching another repo's runtime.
repo=$(repo_name)
runtimes=$(matching_sandboxes "$repo")
runtime_names=$(printf '%s\n' "$runtimes" | cut -f1)

# Bare invocation: show what exists, touch nothing. The list is this
# path's product, so it goes to stdout; the framing goes to stderr.
if [ -z "$target_name" ] && [ "$all" != "1" ]; then
  if [ -z "$runtimes" ]; then
    echo "cleanup-agent-sessions: no runtimes for '$repo'" >&2
    exit 0
  fi
  echo "cleanup-agent-sessions: runtimes for '$repo':" >&2
  printf '%s\n' "$runtimes" | awk -F'\t' '{ printf "%-32s %s\n", $1, $2 }'
  echo "cleanup-agent-sessions: pass --name SESSION to remove one, or --all to remove the stopped ones (running too, with --force)." >&2
  exit 0
fi

# Assemble the list of runtimes to remove.
if [ -n "$target_name" ]; then
  if ! contains_line "$runtime_names" "$target_name"; then
    echo "cleanup-agent-sessions: no runtime named '$target_name' for '$repo'" >&2
    exit 1
  fi
  target_status=$(printf '%s\n' "$runtimes" | awk -F'\t' -v n="$target_name" '$1 == n { print $2 }')
  if [ "$target_status" != "stopped" ] && [ "$force" != "1" ]; then
    echo "cleanup-agent-sessions: '$target_name' is $target_status; pass --force to remove it anyway" >&2
    exit 1
  fi
  targets="$target_name"
else
  if [ -z "$runtimes" ]; then
    echo "cleanup-agent-sessions: no runtimes for '$repo'" >&2
    exit 0
  fi
  if [ "$force" = "1" ]; then
    targets="$runtime_names"
  else
    targets=$(printf '%s\n' "$runtimes" | awk -F'\t' '$2 == "stopped" { print $1 }')
    skipped=$(printf '%s\n' "$runtimes" | awk -F'\t' '$2 != "stopped" { print $1 }')
    if [ -n "$skipped" ]; then
      echo "cleanup-agent-sessions: keeping these (running, or state unknown); pass --force to remove them too:" >&2
      printf '%s\n' "$skipped" | sed 's/^/  /' >&2
    fi
    if [ -z "$targets" ]; then
      echo "cleanup-agent-sessions: no stopped runtimes for '$repo'" >&2
      exit 0
    fi
  fi
fi

echo "cleanup-agent-sessions: to remove, with volumes:" >&2
printf '%s\n' "$targets" | sed 's/^/  /' >&2

if [ "$dry_run" = "1" ]; then
  echo "cleanup-agent-sessions: --dry-run, nothing removed" >&2
  exit 0
fi

confirm_or_die "Remove the runtime(s) listed above and their volumes? [y/N] " "$force"

while IFS= read -r name; do
  [ -z "$name" ] && continue
  remove_runtime "$name"
done <<<"$targets"
