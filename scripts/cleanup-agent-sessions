#!/usr/bin/env bash
# Removes stopped agent-runtime sandboxes for this repo (or, with --name,
# one specific sandbox) along with each one's paired
# <session-name>-docker-data volume. Never touches CLAUDE_AUTH_VOLUME
# (default: agent-claude-creds), which is shared across sessions - remove
# it by hand with `msb volume remove` if needed.
#
# Usage:
#   scripts/cleanup-agent-sessions [--name SESSION] [--dry-run] [--force]
#
#   --name SESSION   remove only this one sandbox and its volume, running
#                    or not (running requires --force too)
#   --dry-run        list what would be removed, without removing anything
#   --force          skip the confirmation prompt; also required to
#                    remove a running --name sandbox

set -eo pipefail

# shellcheck source=lib/agent-runtime.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/agent-runtime.sh"

dry_run=0
force=0
target_name=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --name)
      target_name="$2"
      shift 2
      ;;
    --dry-run)
      dry_run=1
      shift
      ;;
    --force)
      force=1
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      echo "cleanup-agent-sessions: unrecognized argument: $1" >&2
      usage
      exit 1
      ;;
  esac
done

if [ -n "$target_name" ]; then
  status=$(msb list --format json 2>/dev/null | jq -r --arg name "$target_name" '.[] | select(.name == $name) | .status')
  if [ -z "$status" ]; then
    echo "cleanup-agent-sessions: no sandbox named '$target_name'" >&2
    exit 1
  fi
  if [ "$status" = "Running" ] && [ "$force" != "1" ]; then
    echo "cleanup-agent-sessions: '$target_name' is currently running; pass --force to remove it anyway" >&2
    exit 1
  fi
  targets="$target_name"
else
  repo=$(repo_name)
  targets=$(msb list --label "repo=$repo" --stopped -q 2>/dev/null || true)

  if [ -z "$targets" ]; then
    echo "cleanup-agent-sessions: no stopped sandboxes for '$repo'" >&2
    exit 0
  fi
fi

echo "cleanup-agent-sessions: sandbox(es) to remove:" >&2
printf '%s\n' "$targets" | sed 's/^/  /' >&2

if [ "$dry_run" = "1" ]; then
  echo "cleanup-agent-sessions: --dry-run, nothing removed" >&2
  exit 0
fi

if [ "$force" != "1" ]; then
  if [ ! -t 0 ]; then
    echo "cleanup-agent-sessions: stdin isn't a terminal to confirm on; pass --force to remove without asking" >&2
    exit 1
  fi

  read -r -p "Remove these and their volumes? [y/N] " confirm
  case "$confirm" in
    y | Y) ;;
    *)
      echo "cleanup-agent-sessions: aborted" >&2
      exit 1
      ;;
  esac
fi

while IFS= read -r name; do
  [ -z "$name" ] && continue
  msb rm -f "$name"
  # Best-effort: DOCKER_DATA_VOLUME may have been overridden away from the
  # default at launch time, in which case there's nothing named this to
  # remove, and that's fine.
  msb volume remove "${name}-docker-data" >/dev/null 2>&1 || true
done <<<"$targets"
