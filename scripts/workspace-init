#!/bin/sh
# Registered into the guest as `workspace-init` (scripts/launch-agent-runtime),
# ADR-0015: a full clone made inside the guest at launch. Runs first, then
# execs the given command from inside the clone.
#
# No --depth: /code-review's git merge-base needs full history. No --ref: a
# ref flag would default to the host's current branch and fail at boot
# whenever that branch is unpushed (ADR-0015).
set -eu

: "${WORKSPACE_CLONE_URL:?WORKSPACE_CLONE_URL must be set - scripts/launch-agent-runtime always sets it}"
: "${PERSIST_CLAUDE_AUTH:=0}"

# Issue #54: under --persist-claude-auth, symlink ~/.claude.json (Claude Code
# state, a sibling of ~/.claude) into the ~/.claude volume so its writes
# survive relaunch. Every launch: a fresh guest ships its own ~/.claude.json
# that must be replaced before Claude Code reads it.
if [ "$PERSIST_CLAUDE_AUTH" = "1" ]; then
  claude_json="$HOME/.claude/claude.json"
  [ -e "$claude_json" ] || echo '{}' >"$claude_json"
  ln -sfn "$claude_json" "$HOME/.claude.json"
fi

# dotfiles-bootstrap (ADR-0016): idempotent and a no-op with DOTFILES_REPO
# unset, so unconditional. Every launch, not just the first: under
# --persist-claude-auth the persistent ~/.claude/CLAUDE.md symlinks to an
# ephemeral-disk target that a skipped launch would leave dangling.
dotfiles-bootstrap

repo_dir="$HOME/$(basename "$WORKSPACE_CLONE_URL" .git)"

git clone "$WORKSPACE_CLONE_URL" "$repo_dir"
cd "$repo_dir"

exec "$@"
