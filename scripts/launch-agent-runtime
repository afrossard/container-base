#!/usr/bin/env bash
# Launches the published -agent image as a disposable microsandbox guest
# (ADR-0013, ADR-0014; the ADR-0001 exception for host-side tooling).
#
# Usage:
#   scripts/launch-agent-runtime [--name SESSION] [--image REF] \
#     [--clone-url URL] [--github-token ENV|-] [--secret ENV@HOST]... \
#     [--memory SIZE] [--cpus N] [--max-memory SIZE] [-- COMMAND...]
#
#   --name SESSION       sandbox name (default: <repo>-sandbox). Reuses a
#                        matching sandbox by its `repo=<repo>` label;
#                        prompts if more than one matches.
#   --image REF          agent image to launch (default: the pinned
#                        -agent image in `image=` below, which
#                        release-please bumps)
#   --github-token ENV   inject a GitHub token scoped to github.com (git)
#                        and api.github.com (gh); scoping to github.com
#                        alone breaks every gh command (issue #77). ENV is
#                        a host env var name, not a value. Implies
#                        --on-secret-violation block-and-log. At most once.
#                        Pass `-` to read the token on stdin instead:
#                        prompted (hidden) at a terminal, one line
#                        otherwise, e.g.
#                          pass show gh/pat | launch-agent-runtime --github-token -
#   --secret ENV@HOST    forwarded to `msb run --secret` (repeatable); ENV
#                        is a host env var name, not a literal value
#   --on-secret-violation ACTION
#                        forwarded to `msb run --on-secret-violation`
#                        (block, block-and-log, block-and-terminate,
#                        passthrough; recommended: block-and-log with --secret)
#   --memory SIZE        forwarded to `msb run --memory` (default: 4G)
#   --cpus N             forwarded to `msb run --cpus` (default: 4)
#   --max-memory SIZE    forwarded to `msb run --max-memory` (default: 16G)
#   --clone-url URL      repo to clone into the guest
#                        (default: `git remote get-url origin`)
#   --force              skip the confirmation before replacing a running
#                        sandbox
#   --persist-claude-auth / --no-persist-claude-auth
#                        persist Claude Code's login across sessions
#                        (default: on with no COMMAND, off otherwise)
#
# With no COMMAND, opens an interactive shell; with one, runs it
# non-interactively.
#
# Environment:
#   DOCKER_DATA_VOLUME   /var/lib/docker volume name
#                        (default: <session name>-docker-data)
#   DOCKER_DATA_SIZE     size of that volume (default: 20G)
#   CLAUDE_AUTH_VOLUME   ~/.claude volume used by --persist-claude-auth
#                        (default: agent-claude-creds)

# Not -u: bash 3.2 (macOS) treats "${secrets[@]}" as unbound while the
# array is still empty.
set -eo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/agent-runtime.sh
source "$script_dir/lib/agent-runtime.sh"

: "${DOCKER_DATA_SIZE:=20G}"

version="0.4.1" # x-release-please-version
image="ghcr.io/afrossard/container-base:${version}-agent"
name=""
force=0
persist_claude_auth=""
clone_url=""
github_token_env=""
github_token_from_stdin=0
secrets=()
violation_flag=()
memory="4G"
cpus="4"
max_memory="16G"

# "name<TAB>status" for sandboxes matching this repo's label plus any
# exact-name match (pre-label sandboxes). A name in neither status list is
# reported "unknown", not dropped.
matching_sandboxes() {
  local base="$1" names running stopped name status
  running=$(msb list --running -q 2>/dev/null || true)
  stopped=$(msb list --stopped -q 2>/dev/null || true)

  names=$(
    {
      msb list --label "repo=$base" -q 2>/dev/null || true
      if sandbox_exists "$base"; then printf '%s\n' "$base"; fi
    } | sort -u
  )
  if [ -z "$names" ]; then
    return 0
  fi

  while IFS= read -r name; do
    if [ -z "$name" ]; then
      continue
    fi
    if contains_line "$running" "$name"; then
      status=running
    elif contains_line "$stopped" "$name"; then
      status=stopped
    else
      status=unknown
    fi
    printf '%s\t%s\n' "$name" "$status"
  done <<<"$names"
}

# Confirms before replacing a running sandbox (honours --force). Sets $name
# directly, not via command substitution, so `exit` ends the whole script.
confirm_replace_if_running() {
  local target="$1" offer_new="$2" choice
  sandbox_is_running "$target" || return 0
  [ "$force" = "1" ] && return 0

  if [ ! -t 0 ]; then
    echo "launch-agent-runtime: '$target' is currently running; pass --force to replace it anyway, or 'msb exec $target' to attach to it instead" >&2
    exit 1
  fi

  echo "launch-agent-runtime: '$target' is currently running." >&2
  if [ "$offer_new" = "1" ]; then
    read -r -p "Replace it, start a new one instead, or abort? [r/n/A] " choice
    case "$choice" in
      r | R) ;;
      n | N) name=$(printf '%s-sandbox-%04d' "$(repo_name)" "$((RANDOM % 10000))") ;;
      *)
        echo "launch-agent-runtime: aborted" >&2
        exit 1
        ;;
    esac
  else
    read -r -p "Replace it anyway? [y/N] " choice
    case "$choice" in
      y | Y) ;;
      *)
        echo "launch-agent-runtime: aborted" >&2
        exit 1
        ;;
    esac
  fi
}

# Reuses the one sandbox for this repo, asks if several, mints
# `<repo>-sandbox` (or `-sandbox-NNNN` on collision) if none.
resolve_name() {
  local base matches count target choice
  base=$(repo_name)
  matches=$(matching_sandboxes "$base")

  if [ -z "$matches" ]; then
    printf '%s-sandbox' "$base"
    return
  fi

  count=$(printf '%s\n' "$matches" | wc -l | tr -d ' ')
  if [ "$count" -eq 1 ]; then
    target=$(printf '%s' "$matches" | cut -f1)
  else
    if [ ! -t 0 ]; then
      echo "launch-agent-runtime: multiple existing sandboxes match '$base' and stdin isn't a terminal to ask; pass --name explicitly:" >&2
      printf '%s\n' "$matches" | awk -F'\t' '{print "  " $1 " (" $2 ")"}' >&2
      exit 1
    fi

    echo "launch-agent-runtime: multiple existing sandboxes match '$base':" >&2
    printf '%s\n' "$matches" | awk -F'\t' '{print NR") " $1 " (" $2 ")"}' >&2
    echo "  n) start a new one" >&2
    read -r -p "Which one? " choice

    if [ "$choice" = "n" ] || [ "$choice" = "N" ]; then
      printf '%s-sandbox-%04d' "$base" "$((RANDOM % 10000))"
      return
    fi
    target=$(printf '%s\n' "$matches" | sed -n "${choice}p" | cut -f1)
  fi

  printf '%s' "$target"
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --name)
      name="$2"
      shift 2
      ;;
    --image)
      image="$2"
      shift 2
      ;;
    --github-token)
      # A literal `-` means read the token from stdin, done further down.
      if [ "$2" = "-" ]; then
        github_token_from_stdin=1
        shift 2
        continue
      fi
      # Takes the NAME of a var. `--github-token "$GH_TOKEN"` would leak the
      # token into argv (visible to `ps`). Tokens are identifier-shaped, so
      # the charset check alone won't catch the slip - the set-check does.
      # Neither check echoes what it rejected.
      case "$2" in
        '' | [0-9]* | *[!A-Za-z0-9_]*)
          echo "launch-agent-runtime: --github-token takes the name of a host environment variable (e.g. GH_TOKEN), not a token value" >&2
          exit 1
          ;;
      esac
      if ! printenv "$2" >/dev/null 2>&1; then
        echo "launch-agent-runtime: --github-token names an environment variable that is not set (and it takes the variable's name, not the token value itself)" >&2
        exit 1
      fi
      github_token_env="$2"
      github_token_from_stdin=0
      shift 2
      ;;
    --secret)
      secrets+=(--secret "$2")
      shift 2
      ;;
    --on-secret-violation)
      violation_flag=(--on-secret-violation "$2")
      shift 2
      ;;
    --memory)
      memory="$2"
      shift 2
      ;;
    --cpus)
      cpus="$2"
      shift 2
      ;;
    --max-memory)
      max_memory="$2"
      shift 2
      ;;
    --clone-url)
      clone_url="$2"
      shift 2
      ;;
    --force)
      force=1
      shift
      ;;
    --persist-claude-auth)
      persist_claude_auth=1
      shift
      ;;
    --no-persist-claude-auth)
      persist_claude_auth=0
      shift
      ;;
    --)
      shift
      break
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      echo "launch-agent-runtime: unrecognized argument: $1" >&2
      usage
      exit 1
      ;;
  esac
done

# After the parse loop, so --help works without them.
require_tools msb git

if [ -z "$clone_url" ]; then
  if ! clone_url=$(repo_url); then
    echo "launch-agent-runtime: no 'origin' remote to clone from; pass --clone-url explicitly" >&2
    exit 1
  fi
fi

# No command: default to zsh, not bash - only zsh sources /etc/zsh/zshenv
# (ADR-0010), where the image's PATH additions live.
tty_flag="--no-tty"
if [ "$#" -eq 0 ]; then
  # Neither flag given: default here, before $# changes below.
  : "${persist_claude_auth:=1}"
  set -- zsh
  tty_flag="-t"
fi
: "${persist_claude_auth:=0}"

if [ -z "$name" ]; then
  name=$(resolve_name)
  offer_new=1
else
  offer_new=0
fi

# Applies to an explicit --name too - same silent-kill risk either way.
confirm_replace_if_running "$name" "$offer_new"
echo "launch-agent-runtime: session name: $name" >&2

# `--github-token -` reads the token here, not in the parse loop, so
# aborting the replace prompt above doesn't waste a typed secret.
#
# The forwarded var name reaches the guest as-is, and `gh` there reads only
# GH_TOKEN or GITHUB_TOKEN, so the name must be one of those. Exporting here
# touches only this process.
if [ "$github_token_from_stdin" = "1" ]; then
  # `|| true`: read reports EOF for input with no trailing newline (a
  # password-manager pipe) and for Ctrl-D, and `set -e` would kill the
  # launch. Emptiness is checked below either way.
  if [ -t 0 ]; then
    printf 'GitHub token (input hidden): ' >&2
    IFS= read -rs prompted_token || true
    printf '\n' >&2
  else
    IFS= read -r prompted_token || true
  fi

  # Strip surrounding whitespace and CR: a CRLF pipe or a hand-paste adds
  # bytes that aren't part of any token and produce "invalid token" in the
  # guest (issue #77). `[:space:]` covers \r.
  prompted_token="${prompted_token#"${prompted_token%%[![:space:]]*}"}"
  prompted_token="${prompted_token%"${prompted_token##*[![:space:]]}"}"

  if [ -z "$prompted_token" ]; then
    echo "launch-agent-runtime: --github-token - read an empty token" >&2
    exit 1
  fi

  export GH_TOKEN="$prompted_token"
  github_token_env="GH_TOKEN"
fi

# Both --github-token paths converge here on a variable name.
if [ -n "$github_token_env" ]; then
  secrets+=(--secret "${github_token_env}@github.com,api.github.com")

  # Applies the --on-secret-violation recommendation, only when the caller
  # gave none. This tightens the default, doesn't widen it.
  if [ "${#violation_flag[@]}" -eq 0 ]; then
    violation_flag=(--on-secret-violation block-and-log)
  fi
fi

: "${DOCKER_DATA_VOLUME:=${name}-docker-data}"

ensure_volume "$DOCKER_DATA_VOLUME" --kind disk --size "$DOCKER_DATA_SIZE"

claude_mounts=()
if [ "$persist_claude_auth" = "1" ]; then
  : "${CLAUDE_AUTH_VOLUME:=agent-claude-creds}"

  ensure_volume "$CLAUDE_AUTH_VOLUME" --kind dir

  claude_mounts=(
    --mount-named "${CLAUDE_AUTH_VOLUME}:/home/vscode/.claude"
  )
fi

# Pins network egress explicitly: msb's implicit default reverts to no
# egress once any --net-rule is added. A hostname allowlist was rejected -
# this workload's egress isn't enumerable (apt, GHCR, npm, GitHub, ...).
# See ADR-0013.
exec msb run --replace "$tty_flag" --name "$name" --label "repo=$(repo_name)" \
  --memory "$memory" --cpus "$cpus" --max-memory "$max_memory" \
  --net public \
  "${secrets[@]}" \
  "${violation_flag[@]}" \
  --mount-named "${DOCKER_DATA_VOLUME}:/var/lib/docker:kind=disk,size=${DOCKER_DATA_SIZE}" \
  "${claude_mounts[@]}" \
  --script-path "workspace-init:${script_dir}/workspace-init" \
  --env "WORKSPACE_CLONE_URL=${clone_url}" \
  --env "DOTFILES_REPO=${DOTFILES_REPO:-}" \
  --env "PERSIST_CLAUDE_AUTH=${persist_claude_auth}" \
  "$image" -- workspace-init "$@"
