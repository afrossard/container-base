#!/usr/bin/env bash
# Owns the agent runtime's lifecycle (ADR-0021; ADR-0013, ADR-0014, and the
# ADR-0001 exception for host-side tooling).
#
# Usage:
#   scripts/launch-agent-runtime [--name NAME] [--image REF] \
#     [--clone-url URL] [--secret ENV@HOST]... [--secret-violation-action ACTION] \
#     [--allow-url URL]... [--memory SIZE] [--cpus N] [--max-memory SIZE] \
#     [-- COMMAND...]
#   scripts/launch-agent-runtime --reset [--name NAME] [--force]
#
# A bare launch attaches to this repo's agent runtime, resuming it if
# stopped and creating one only if none exists - it never destroys one.
# Every path converges the runtime with agent-bringup (docker daemon,
# dotfiles, workspace clone) and then hands over as the working user in the
# workspace directory.
#
# --reset is the only launcher path that destroys a runtime: it removes
# the runtime and its paired docker storage volume, taking everything the
# runtime accumulated - tooling, configuration, logins, unpushed work -
# with it (ADR-0021). It prompts for confirmation unless --force is given.
# The next launch then creates a fresh runtime. (cleanup-agent-sessions
# also removes runtimes, on demand and by name or --all.)
#
#   --reset             destroy this repo's runtime and its docker volume,
#                        after a confirmation prompt; the launcher's one
#                        destruction path
#   --force             with --reset, skip the confirmation prompt (for
#                        scripted resets); invalid on its own
#   --name NAME          runtime name (default: <repo>-sandbox). Attaches to
#                        a matching runtime by its `repo=<repo>` label,
#                        resuming it if stopped; prompts if more than one
#                        matches, with a "start a new one" option.
#   --image REF          agent image to launch (default: the pinned
#                        -agent image in `image=` below, which
#                        release-please bumps)
#   --secret ENV@HOST    forwarded to `msb run --secret` (repeatable); ENV
#                        is a host env var name, not a literal value
#   --secret-violation-action ACTION
#                        forwarded to `msb run --secret-violation-action`
#                        (block, block-and-log, block-and-terminate;
#                        recommended: block-and-log with --secret). `passthrough`
#                        is rejected here - it's scoped per secret now, not
#                        sandbox-wide (see the error message for the syntax)
#   --allow-url URL      let the runtime reach one LAN service through the
#                        private-network block (repeatable), e.g.
#                        https://nas.lan or http://192.168.1.20:8080. The
#                        whole host:port is reachable, not just the path;
#                        the port is the URL's, else 80/443 for http/https;
#                        one port per host; LAN addresses only (10/8,
#                        172.16/12, 192.168/16, 100.64/10). The host is
#                        resolved here, on this machine, and both it and
#                        the rule are fixed when the runtime is created: to
#                        add or change one, --reset, then launch with the
#                        new set (ADR-0025)
#   --memory SIZE        forwarded to `msb run --memory` (default: 4G)
#   --cpus N             forwarded to `msb run --cpus` (default: 4)
#   --max-memory SIZE    forwarded to `msb run --max-memory` (default: 16G)
#   --clone-url URL      repo to clone into the runtime on first creation
#                        (default: `git remote get-url origin`)
#
# With no COMMAND, opens an interactive shell; with one, runs it
# non-interactively. Both attach as the working user in the workspace, at
# /home/vscode/git/<repo> (the same convention the tooling repo clone
# lands under, per the host's own ~/git/<repo> layout).
#
# Each runtime gets a disk-backed /var/lib/containerd volume named
# <runtime name>-docker-data - derived from the name, so --reset and
# cleanup-agent-sessions can always find it. Pre-create it yourself to
# control its placement; otherwise the launcher creates it.
#
# Environment:
#   DOCKER_DATA_SIZE     size of that volume when the launcher creates it
#                        (default: 20G)
#   TOOLING_REPO         tooling repo to clone into the runtime at boot,
#                        passed through the same as DOTFILES_REPO (default:
#                        this repo's own clone URL, so the tooling recipes
#                        are on disk whatever the workspace is)

# Not -u: bash 3.2 (macOS) treats "${secrets[@]}" as unbound while the
# array is still empty.
set -eo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/agent-runtime.sh
source "$script_dir/lib/agent-runtime.sh"

: "${DOCKER_DATA_SIZE:=20G}"
: "${TOOLING_REPO:=https://github.com/afrossard/container-base.git}"

version="5.1.0" # x-release-please-version
image="ghcr.io/afrossard/container-base:${version}-agent"
name=""
clone_url=""
reset=0
force=0
secrets=()
violation_flag=()
allow_endpoints=()
memory="4G"
cpus="4"
max_memory="16G"

# Prints "HOST PORT" for one --allow-url URL. msb filters on address,
# protocol, and port, never path, so the path is dropped; a URL with no port
# takes its scheme's default (http, https only). Refuses, with a message,
# anything that isn't exactly one host and port.
allow_url_endpoint() {
  local url="$1" authority scheme host port
  local url_re='^([A-Za-z][A-Za-z0-9+.-]*)://([^/?#]*)'
  local authority_re='^([A-Za-z0-9.-]+)(:([0-9]{1,5}))?$'

  if ! [[ "$url" =~ $url_re ]]; then
    echo "launch-agent-runtime: --allow-url '$url' is not a URL; expected SCHEME://HOST[:PORT]" >&2
    return 1
  fi
  # Schemes are case-insensitive (RFC 3986); bash 3.2 has no ${var,,}.
  scheme=$(printf '%s' "${BASH_REMATCH[1]}" | tr '[:upper:]' '[:lower:]')
  authority="${BASH_REMATCH[2]}"

  if ! [[ "$authority" =~ $authority_re ]]; then
    echo "launch-agent-runtime: --allow-url '$url' must name a plain host or IPv4 address and an optional port (no credentials, no IPv6 literal)" >&2
    return 1
  fi
  host="${BASH_REMATCH[1]}"
  port="${BASH_REMATCH[3]}"

  if [ -z "$port" ]; then
    case "$scheme" in
      http) port=80 ;;
      https) port=443 ;;
      *)
        echo "launch-agent-runtime: --allow-url '$url' names no port and '$scheme' has no default here; add :PORT" >&2
        return 1
        ;;
    esac
  fi
  # Strip leading zeros before the range check so 08080 isn't read as octal.
  port=$((10#$port))
  if [ "$port" -lt 1 ] || [ "$port" -gt 65535 ]; then
    echo "launch-agent-runtime: --allow-url '$url' has port $port, outside 1-65535" >&2
    return 1
  fi

  printf '%s %s' "$host" "$port"
}

# Prints HOST's IPv4 addresses, one per line, as the host resolves them:
# getent on Linux, dscacheutil on macOS. An IPv4 literal is its own answer.
resolve_ipv4() {
  local host="$1"
  if [[ "$host" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]]; then
    printf '%s\n' "$host"
  elif command -v getent >/dev/null 2>&1; then
    getent ahostsv4 "$host" | awk '{print $1}' | sort -u
  else
    dscacheutil -q host -a name "$host" | awk '/^ip_address:/ {print $2}' | sort -u
  fi
}

# True if ADDRESS is a well-formed IPv4 address in a LAN range: RFC 1918 or
# carrier-grade NAT (100.64.0.0/10, where Tailscale lives). Public
# addresses are left out because --net public already allows them, and a
# rule group would narrow one to a single port; loopback and link-local
# (cloud metadata) are never a LAN service.
is_lan_ipv4() {
  local a b c d
  [[ "$1" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || return 1
  a=$((10#${BASH_REMATCH[1]})) b=$((10#${BASH_REMATCH[2]}))
  c=$((10#${BASH_REMATCH[3]})) d=$((10#${BASH_REMATCH[4]}))
  [ "$a" -le 255 ] && [ "$b" -le 255 ] && [ "$c" -le 255 ] && [ "$d" -le 255 ] || return 1
  [ "$a" -eq 10 ] && return 0
  [ "$a" -eq 172 ] && [ "$b" -ge 16 ] && [ "$b" -le 31 ] && return 0
  [ "$a" -eq 192 ] && [ "$b" -eq 168 ] && return 0
  [ "$a" -eq 100 ] && [ "$b" -ge 64 ] && [ "$b" -le 127 ] && return 0
  return 1
}

# Prints the msb rule group allowing exactly TCP PORT at ADDRESS, in the
# shape measured against msb 0.7.13 on issue #234. DNS rebind protection
# rewrites a private answer to NXDOMAIN unless an address-only rule allows
# that address, so the group ends in a bare allow@ADDRESS; msb applies the
# first matching rule, so port-range denies ahead of it narrow that back to
# the one port. They must be port ranges: a protocol-wide deny@ADDRESS:tcp
# counts as an address deny and re-arms rebind protection.
one_port_rule() {
  local address="$1" port="$2" rule=""
  if [ "$port" -gt 1 ]; then
    rule="deny@${address}:tcp:1-$((port - 1)),"
  fi
  if [ "$port" -lt 65535 ]; then
    rule="${rule}deny@${address}:tcp:$((port + 1))-65535,"
  fi
  printf '%sdeny@%s:udp,allow@%s' "$rule" "$address" "$address"
}

# Reuses the one sandbox for this repo, asks if several, mints
# `<repo>-sandbox` (or `-sandbox-NNNN` on collision) if none.
resolve_name() {
  local base matches count target choice
  base=$(repo_name)
  matches=$(matching_sandboxes "$base")

  if [ -z "$matches" ]; then
    printf '%s-sandbox' "$base"
    return
  fi

  count=$(printf '%s\n' "$matches" | wc -l | tr -d ' ')
  if [ "$count" -eq 1 ]; then
    target=$(printf '%s' "$matches" | cut -f1)
  else
    if [ ! -t 0 ]; then
      echo "launch-agent-runtime: multiple existing sandboxes match '$base' and stdin isn't a terminal to ask; pass --name explicitly:" >&2
      printf '%s\n' "$matches" | awk -F'\t' '{print "  " $1 " (" $2 ")"}' >&2
      exit 1
    fi

    echo "launch-agent-runtime: multiple existing sandboxes match '$base':" >&2
    printf '%s\n' "$matches" | awk -F'\t' '{print NR") " $1 " (" $2 ")"}' >&2
    echo "  n) start a new one" >&2
    read -r -p "Which one? " choice

    if [ "$choice" = "n" ] || [ "$choice" = "N" ]; then
      printf '%s-sandbox-%04d' "$base" "$((RANDOM % 10000))"
      return
    fi
    target=$(printf '%s\n' "$matches" | sed -n "${choice}p" | cut -f1)
  fi

  printf '%s' "$target"
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --name)
      name="$2"
      shift 2
      ;;
    --image)
      image="$2"
      shift 2
      ;;
    --secret)
      secrets+=(--secret "$2")
      shift 2
      ;;
    --secret-violation-action)
      if [ "$2" = "passthrough" ]; then
        echo "launch-agent-runtime: --secret-violation-action passthrough is rejected; msb scopes passthrough per secret now (--secret ENV:passthrough=HOST@...), not sandbox-wide" >&2
        exit 1
      fi
      violation_flag=(--secret-violation-action "$2")
      shift 2
      ;;
    --allow-url)
      allow_endpoint=$(allow_url_endpoint "$2") || exit 1
      allow_endpoints+=("$allow_endpoint")
      shift 2
      ;;
    --memory)
      memory="$2"
      shift 2
      ;;
    --cpus)
      cpus="$2"
      shift 2
      ;;
    --max-memory)
      max_memory="$2"
      shift 2
      ;;
    --clone-url)
      clone_url="$2"
      shift 2
      ;;
    --reset)
      reset=1
      shift
      ;;
    --force)
      force=1
      shift
      ;;
    --)
      shift
      break
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      echo "launch-agent-runtime: unrecognized argument: $1" >&2
      usage
      exit 1
      ;;
  esac
done

# After the parse loop, so --help works without them.
require_tools msb git

if [ "$force" = "1" ] && [ "$reset" != "1" ]; then
  echo "launch-agent-runtime: --force only applies to --reset" >&2
  usage
  exit 1
fi

if [ "$reset" = "1" ] && [ "${#allow_endpoints[@]}" -gt 0 ]; then
  echo "launch-agent-runtime: --allow-url doesn't apply to --reset; pass it to the launch after the reset" >&2
  exit 1
fi

# The one destruction path (ADR-0021). Acts only on this repo's runtimes
# (the `repo=<repo>` label set), so a --name from the wrong checkout can't
# reach another repo's runtime, and never routes through the attach
# picker's "start a new one" branch. Refuses on nothing, or on several
# with no --name; confirms unless --force; then removes the runtime and
# its paired docker volume.
if [ "$reset" = "1" ]; then
  reset_base=$(repo_name)
  reset_matches=$(matching_sandboxes "$reset_base")
  reset_names=$(printf '%s\n' "$reset_matches" | cut -f1)

  if [ -n "$name" ]; then
    if ! contains_line "$reset_names" "$name"; then
      echo "launch-agent-runtime: no runtime named '$name' for '$reset_base' to reset" >&2
      exit 1
    fi
  else
    if [ -z "$reset_matches" ]; then
      echo "launch-agent-runtime: no runtime for '$reset_base' to reset" >&2
      exit 1
    fi
    reset_count=$(printf '%s\n' "$reset_matches" | wc -l | tr -d ' ')
    if [ "$reset_count" -gt 1 ]; then
      echo "launch-agent-runtime: several runtimes match '$reset_base'; pass --name to choose which to reset:" >&2
      printf '%s\n' "$reset_matches" | awk -F'\t' '{print "  " $1 " (" $2 ")"}' >&2
      exit 1
    fi
    name=$(printf '%s' "$reset_matches" | cut -f1)
  fi

  echo "launch-agent-runtime: reset destroys runtime '$name' and its docker volume '${name}-docker-data'." >&2
  echo "launch-agent-runtime: everything it accumulated - tooling, configuration, logins, unpushed work - goes with it (ADR-0021)." >&2

  confirm_or_die "Reset '$name'? [y/N] " "$force"

  remove_runtime "$name"
  echo "launch-agent-runtime: reset complete; the next launch creates a fresh runtime" >&2
  exit 0
fi

if [ -z "$clone_url" ]; then
  if ! clone_url=$(repo_url); then
    echo "launch-agent-runtime: no 'origin' remote to clone from; pass --clone-url explicitly" >&2
    exit 1
  fi
fi

# No command: default to zsh, not bash - only zsh sources /etc/zsh/zshenv
# (ADR-0010), where the image's PATH additions live.
tty_flag="--no-tty"
if [ "$#" -eq 0 ]; then
  set -- zsh
  tty_flag="-t"
fi

if [ -z "$name" ]; then
  name=$(resolve_name)
fi

echo "launch-agent-runtime: runtime name: $name" >&2

# The workspace clone, under the working user's ~/git - where an attach
# lands, and where agent-bringup / ensure-workspace put the clone. The
# tooling clone lands beside it under the same ~/git, via TOOLING_REPO
# below; in this repo's own runtime the two resolve to the same path, and
# clone-if-absent idempotence handles that with no special-casing.
workspace_dir="/home/vscode/git/$(basename "$clone_url" .git)"

# Blocks until the guest agent answers `msb exec`, which `msb start` and a
# fresh `msb run` both return before. ~2 minutes of headroom, then give up
# and let the caller see the real error.
wait_for_agent() {
  local attempt=0
  while [ "$attempt" -lt 60 ]; do
    msb exec --no-tty "$name" -- true >/dev/null 2>&1 && return 0
    attempt=$((attempt + 1))
    sleep 2
  done
  echo "launch-agent-runtime: '$name' did not become reachable after start" >&2
  return 1
}

# Converge the runtime, then hand over as the working user in the workspace.
# Two `msb exec` calls, so the launcher stays agnostic of agent-bringup's
# logic - the devcontainer post-start shape (ADR-0021). A resume needs this
# because `msb start` re-runs nothing (issue #144). A failed convergence
# warns rather than aborts: the operator still gets a shell to debug in
# (ADR-0026), in the home directory if the workspace clone never landed.
attach_to_runtime() {
  local workdir="$workspace_dir"
  wait_for_agent || exit 1
  msb exec --no-tty "$name" -- agent-bringup >&2 \
    || echo "launch-agent-runtime: agent-bringup reported a failure; the runtime may be under-provisioned" >&2
  if ! msb exec --no-tty "$name" -- test -d "$workspace_dir" >/dev/null 2>&1; then
    echo "launch-agent-runtime: WARNING: $workspace_dir is missing; opening in /home/vscode instead" >&2
    workdir=/home/vscode
  fi
  # Last before the handover, so bring-up output doesn't scroll it away.
  if [ "${#allow_endpoints[@]}" -gt 0 ]; then
    echo "launch-agent-runtime: --allow-url is not applied: '$name' keeps the network policy it was created with, and msb can't change it; run with --reset, then launch again with --allow-url" >&2
  fi
  exec msb exec "$tty_flag" -u vscode -w "$workdir" "$name" -- "$@"
}

if sandbox_is_running "$name"; then
  echo "launch-agent-runtime: attaching to running runtime" >&2
  attach_to_runtime "$@"
elif sandbox_exists "$name"; then
  echo "launch-agent-runtime: resuming stopped runtime" >&2
  msb start "$name"
  attach_to_runtime "$@"
fi

echo "launch-agent-runtime: no runtime for this repo, creating one" >&2

# One rule group per address each --allow-url host resolves to, resolved
# here on the host and fixed for the runtime's life. Every address gets
# one: msb drops a whole DNS answer if any private address in it isn't
# allowed. One port per address, so a second URL landing on an allowed
# address is refused rather than merged.
net_rules=()
allowed_addresses=""
for allow_endpoint in "${allow_endpoints[@]}"; do
  allow_host="${allow_endpoint% *}"
  allow_port="${allow_endpoint#* }"
  addresses=$(resolve_ipv4 "$allow_host" || true)
  if [ -z "$addresses" ]; then
    echo "launch-agent-runtime: --allow-url host '$allow_host' does not resolve to an IPv4 address on this host" >&2
    exit 1
  fi
  while IFS= read -r address; do
    if ! is_lan_ipv4 "$address"; then
      echo "launch-agent-runtime: --allow-url host '$allow_host' resolves to $address, which is not a private LAN address (10/8, 172.16/12, 192.168/16, 100.64/10); public addresses are already reachable" >&2
      exit 1
    fi
    if contains_line "$allowed_addresses" "$address"; then
      echo "launch-agent-runtime: --allow-url '$allow_host:$allow_port' resolves to $address, which another --allow-url already allows; one port per host" >&2
      exit 1
    fi
    allowed_addresses="${allowed_addresses}${address}"$'\n'
    net_rules+=(--net-rule "$(one_port_rule "$address" "$allow_port")")
  done <<<"$addresses"
done

docker_volume="${name}-docker-data"

ensure_volume "$docker_volume" --kind disk --size "$DOCKER_DATA_SIZE"

# Pins network egress explicitly: msb's implicit default reverts to no
# egress once any --net-rule is added. A hostname allowlist was rejected -
# this workload's egress isn't enumerable (apt, GHCR, npm, GitHub, ...).
# `--net public` denies every private range (ADR-0013, issue #30); the
# --allow-url rule groups after it are the only exceptions, chosen on the
# host by whoever launches, never read from the checkout the agent edits
# (ADR-0025).
#
# No --replace: this branch runs only when no runtime exists, and a bare
# launch never destroys one (ADR-0021). The entrypoint runs agent-bringup
# on this first boot; the guest carries it, so no --script-path. The `--env`
# values persist in the runtime config and reach the launcher's later
# `msb exec` bring-up calls (verified on issue #144).
exec msb run "$tty_flag" --name "$name" --label "repo=$(repo_name)" \
  --memory "$memory" --cpus "$cpus" --max-memory "$max_memory" \
  --net public \
  "${net_rules[@]}" \
  "${secrets[@]}" \
  "${violation_flag[@]}" \
  --mount-named "${docker_volume}:/var/lib/containerd:kind=disk,size=${DOCKER_DATA_SIZE}" \
  --env "WORKSPACE_CLONE_URL=${clone_url}" \
  --env "DOTFILES_REPO=${DOTFILES_REPO:-}" \
  --env "TOOLING_REPO=${TOOLING_REPO}" \
  "$image" -- "$@"
