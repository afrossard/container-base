#!/usr/bin/env bash
# Owns the agent runtime's lifecycle (ADR-0021; ADR-0013, ADR-0014, and the
# ADR-0001 exception for host-side tooling).
#
# Usage:
#   scripts/launch-agent-runtime [--name NAME] [--image REF] \
#     [--clone-url URL] [--secret ENV@HOST]... [--on-secret-violation ACTION] \
#     [--memory SIZE] [--cpus N] [--max-memory SIZE] [-- COMMAND...]
#   scripts/launch-agent-runtime --reset [--name NAME] [--force]
#
# A bare launch attaches to this repo's agent runtime, resuming it if
# stopped and creating one only if none exists - it never destroys one.
# Every path converges the runtime with agent-bringup (docker daemon,
# dotfiles, workspace clone) and then hands over as the working user in the
# workspace directory.
#
# --reset is the only path that destroys a runtime: it removes the runtime
# and its paired docker storage volume, taking everything the runtime
# accumulated - tooling, configuration, logins, unpushed work - with it
# (ADR-0021). It prompts for confirmation unless --force is given. The next
# launch then creates a fresh runtime.
#
#   --reset             destroy this repo's runtime and its docker volume,
#                        after a confirmation prompt; the only destruction
#                        path
#   --force             with --reset, skip the confirmation prompt (for
#                        scripted resets); invalid on its own
#   --name NAME          runtime name (default: <repo>-sandbox). Attaches to
#                        a matching runtime by its `repo=<repo>` label,
#                        resuming it if stopped; prompts if more than one
#                        matches, with a "start a new one" option.
#   --image REF          agent image to launch (default: the pinned
#                        -agent image in `image=` below, which
#                        release-please bumps)
#   --secret ENV@HOST    forwarded to `msb run --secret` (repeatable); ENV
#                        is a host env var name, not a literal value
#   --on-secret-violation ACTION
#                        forwarded to `msb run --on-secret-violation`
#                        (block, block-and-log, block-and-terminate,
#                        passthrough; recommended: block-and-log with --secret)
#   --memory SIZE        forwarded to `msb run --memory` (default: 4G)
#   --cpus N             forwarded to `msb run --cpus` (default: 4)
#   --max-memory SIZE    forwarded to `msb run --max-memory` (default: 16G)
#   --clone-url URL      repo to clone into the runtime on first creation
#                        (default: `git remote get-url origin`)
#
# With no COMMAND, opens an interactive shell; with one, runs it
# non-interactively. Both attach as the working user in the workspace.
#
# Environment:
#   DOCKER_DATA_VOLUME   /var/lib/docker volume name
#                        (default: <runtime name>-docker-data)
#   DOCKER_DATA_SIZE     size of that volume (default: 20G)

# Not -u: bash 3.2 (macOS) treats "${secrets[@]}" as unbound while the
# array is still empty.
set -eo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/agent-runtime.sh
source "$script_dir/lib/agent-runtime.sh"

: "${DOCKER_DATA_SIZE:=20G}"

version="1.0.0" # x-release-please-version
image="ghcr.io/afrossard/container-base:${version}-agent"
name=""
clone_url=""
reset=0
force=0
secrets=()
violation_flag=()
memory="4G"
cpus="4"
max_memory="16G"

# "name<TAB>status" for sandboxes matching this repo's label plus any
# exact-name match (pre-label sandboxes). A name in neither status list is
# reported "unknown", not dropped.
matching_sandboxes() {
  local base="$1" names running stopped name status
  running=$(msb list --running -q 2>/dev/null || true)
  stopped=$(msb list --stopped -q 2>/dev/null || true)

  names=$(
    {
      msb list --label "repo=$base" -q 2>/dev/null || true
      if sandbox_exists "$base"; then printf '%s\n' "$base"; fi
    } | sort -u
  )
  if [ -z "$names" ]; then
    return 0
  fi

  while IFS= read -r name; do
    if [ -z "$name" ]; then
      continue
    fi
    if contains_line "$running" "$name"; then
      status=running
    elif contains_line "$stopped" "$name"; then
      status=stopped
    else
      status=unknown
    fi
    printf '%s\t%s\n' "$name" "$status"
  done <<<"$names"
}

# Reuses the one sandbox for this repo, asks if several, mints
# `<repo>-sandbox` (or `-sandbox-NNNN` on collision) if none.
resolve_name() {
  local base matches count target choice
  base=$(repo_name)
  matches=$(matching_sandboxes "$base")

  if [ -z "$matches" ]; then
    printf '%s-sandbox' "$base"
    return
  fi

  count=$(printf '%s\n' "$matches" | wc -l | tr -d ' ')
  if [ "$count" -eq 1 ]; then
    target=$(printf '%s' "$matches" | cut -f1)
  else
    if [ ! -t 0 ]; then
      echo "launch-agent-runtime: multiple existing sandboxes match '$base' and stdin isn't a terminal to ask; pass --name explicitly:" >&2
      printf '%s\n' "$matches" | awk -F'\t' '{print "  " $1 " (" $2 ")"}' >&2
      exit 1
    fi

    echo "launch-agent-runtime: multiple existing sandboxes match '$base':" >&2
    printf '%s\n' "$matches" | awk -F'\t' '{print NR") " $1 " (" $2 ")"}' >&2
    echo "  n) start a new one" >&2
    read -r -p "Which one? " choice

    if [ "$choice" = "n" ] || [ "$choice" = "N" ]; then
      printf '%s-sandbox-%04d' "$base" "$((RANDOM % 10000))"
      return
    fi
    target=$(printf '%s\n' "$matches" | sed -n "${choice}p" | cut -f1)
  fi

  printf '%s' "$target"
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --name)
      name="$2"
      shift 2
      ;;
    --image)
      image="$2"
      shift 2
      ;;
    --secret)
      secrets+=(--secret "$2")
      shift 2
      ;;
    --on-secret-violation)
      violation_flag=(--on-secret-violation "$2")
      shift 2
      ;;
    --memory)
      memory="$2"
      shift 2
      ;;
    --cpus)
      cpus="$2"
      shift 2
      ;;
    --max-memory)
      max_memory="$2"
      shift 2
      ;;
    --clone-url)
      clone_url="$2"
      shift 2
      ;;
    --reset)
      reset=1
      shift
      ;;
    --force)
      force=1
      shift
      ;;
    --)
      shift
      break
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      echo "launch-agent-runtime: unrecognized argument: $1" >&2
      usage
      exit 1
      ;;
  esac
done

# After the parse loop, so --help works without them.
require_tools msb git

if [ "$force" = "1" ] && [ "$reset" != "1" ]; then
  echo "launch-agent-runtime: --force only applies to --reset" >&2
  usage
  exit 1
fi

# The one destruction path (ADR-0021). Resolves the same runtime a bare
# launch would act on, refuses if there is nothing to reset, confirms
# unless --force, then removes the runtime and its paired docker volume.
if [ "$reset" = "1" ]; then
  if [ -z "$name" ]; then
    name=$(resolve_name)
  fi
  if ! sandbox_exists "$name"; then
    echo "launch-agent-runtime: no runtime named '$name' to reset" >&2
    exit 1
  fi

  reset_volume="${DOCKER_DATA_VOLUME:-${name}-docker-data}"
  echo "launch-agent-runtime: reset destroys runtime '$name' and its docker volume '$reset_volume'." >&2
  echo "launch-agent-runtime: everything it accumulated - tooling, configuration, logins, unpushed work - goes with it (ADR-0021)." >&2

  if [ "$force" != "1" ]; then
    if [ ! -t 0 ]; then
      echo "launch-agent-runtime: stdin isn't a terminal to confirm on; pass --force to reset without asking" >&2
      exit 1
    fi
    read -r -p "Reset '$name'? [y/N] " confirm
    case "$confirm" in
      y | Y) ;;
      *)
        echo "launch-agent-runtime: reset aborted" >&2
        exit 1
        ;;
    esac
  fi

  remove_runtime "$name" "$reset_volume"
  echo "launch-agent-runtime: reset complete; the next launch creates a fresh runtime" >&2
  exit 0
fi

if [ -z "$clone_url" ]; then
  if ! clone_url=$(repo_url); then
    echo "launch-agent-runtime: no 'origin' remote to clone from; pass --clone-url explicitly" >&2
    exit 1
  fi
fi

# No command: default to zsh, not bash - only zsh sources /etc/zsh/zshenv
# (ADR-0010), where the image's PATH additions live.
tty_flag="--no-tty"
if [ "$#" -eq 0 ]; then
  set -- zsh
  tty_flag="-t"
fi

if [ -z "$name" ]; then
  name=$(resolve_name)
fi

echo "launch-agent-runtime: runtime name: $name" >&2

# The workspace clone under the working user's home - where an attach lands,
# and where agent-bringup / ensure-workspace put the clone.
workspace_dir="/home/vscode/$(basename "$clone_url" .git)"

# Blocks until the guest agent answers `msb exec`, which `msb start` and a
# fresh `msb run` both return before. ~2 minutes of headroom, then give up
# and let the caller see the real error.
wait_for_agent() {
  local attempt=0
  while [ "$attempt" -lt 60 ]; do
    msb exec --no-tty "$name" -- true >/dev/null 2>&1 && return 0
    attempt=$((attempt + 1))
    sleep 2
  done
  echo "launch-agent-runtime: '$name' did not become reachable after start" >&2
  return 1
}

# Converge the runtime, then hand over as the working user in the workspace.
# Two `msb exec` calls, so the launcher stays agnostic of agent-bringup's
# logic - the devcontainer post-start shape (ADR-0021). A resume needs this
# because `msb start` re-runs nothing (issue #144). A failed convergence
# warns rather than aborts: the operator still gets a shell to debug in.
attach_to_runtime() {
  wait_for_agent || exit 1
  msb exec --no-tty "$name" -- agent-bringup >&2 \
    || echo "launch-agent-runtime: agent-bringup reported a failure; the runtime may be under-provisioned" >&2
  exec msb exec "$tty_flag" -u vscode -w "$workspace_dir" "$name" -- "$@"
}

if sandbox_is_running "$name"; then
  echo "launch-agent-runtime: attaching to running runtime" >&2
  attach_to_runtime "$@"
elif sandbox_exists "$name"; then
  echo "launch-agent-runtime: resuming stopped runtime" >&2
  msb start "$name"
  attach_to_runtime "$@"
fi

echo "launch-agent-runtime: no runtime for this repo, creating one" >&2

: "${DOCKER_DATA_VOLUME:=${name}-docker-data}"

ensure_volume "$DOCKER_DATA_VOLUME" --kind disk --size "$DOCKER_DATA_SIZE"

# Pins network egress explicitly: msb's implicit default reverts to no
# egress once any --net-rule is added. A hostname allowlist was rejected -
# this workload's egress isn't enumerable (apt, GHCR, npm, GitHub, ...).
# See ADR-0013.
#
# No --replace: this branch runs only when no runtime exists, and a bare
# launch never destroys one (ADR-0021). The entrypoint runs agent-bringup
# on this first boot; the guest carries it, so no --script-path. The `--env`
# values persist in the runtime config and reach the launcher's later
# `msb exec` bring-up calls (verified on issue #144).
exec msb run "$tty_flag" --name "$name" --label "repo=$(repo_name)" \
  --memory "$memory" --cpus "$cpus" --max-memory "$max_memory" \
  --net public \
  "${secrets[@]}" \
  "${violation_flag[@]}" \
  --mount-named "${DOCKER_DATA_VOLUME}:/var/lib/docker:kind=disk,size=${DOCKER_DATA_SIZE}" \
  --env "WORKSPACE_CLONE_URL=${clone_url}" \
  --env "DOTFILES_REPO=${DOTFILES_REPO:-}" \
  "$image" -- "$@"
