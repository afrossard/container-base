#!/usr/bin/env bash
# Launches the published -agent image as a disposable microsandbox guest
# (ADR-0013, ADR-0014; the ADR-0001 exception for host-side tooling).
#
# Usage:
#   scripts/launch-agent-runtime [--name SESSION] [--image REF] \
#     [--clone-url URL] [--github-token ENV|-] [--secret ENV@HOST]... \
#     [--memory SIZE] [--cpus N] [--max-memory SIZE] [-- COMMAND...]
#
#   --name SESSION       sandbox name (default: <repo>-sandbox). Reuses a
#                        matching sandbox by its `repo=<repo>` label;
#                        prompts if more than one matches.
#   --image REF          agent image to launch (default: the pinned
#                        -agent image in `image=` below, which
#                        release-please bumps; not repeated here, so it
#                        cannot drift)
#   --github-token ENV   inject a GitHub token scoped to both hosts a
#                        session needs: github.com for git, api.github.com
#                        for gh. ENV is a host env var name, not a literal
#                        value. Scoping to github.com alone leaves every gh
#                        command failing with "the token is invalid", so
#                        prefer this over spelling the scope out by hand
#                        (issue #77). Implies --on-secret-violation
#                        block-and-log unless that flag is given explicitly.
#                        Give it at most once; a second one replaces the
#                        first, since one session has one GitHub identity.
#                        Pass `-` instead of a name to supply the token
#                        itself on stdin, so nothing need be exported:
#                        prompted (hidden) when stdin is a terminal, read
#                        as one line when it isn't, e.g.
#                          launch-agent-runtime --github-token -
#                          pass show gh/pat | launch-agent-runtime --github-token -
#   --secret ENV@HOST    forwarded to `msb run --secret` (repeatable); ENV
#                        is a host env var name, not a literal value
#   --on-secret-violation ACTION
#                        forwarded to `msb run --on-secret-violation`
#                        (block, block-and-log, block-and-terminate,
#                        passthrough; recommended: block-and-log whenever
#                        --secret is used)
#   --memory SIZE        forwarded to `msb run --memory` (default: 4G)
#   --cpus N             forwarded to `msb run --cpus` (default: 4)
#   --max-memory SIZE    forwarded to `msb run --max-memory` (default: 16G)
#   --clone-url URL      repo to clone into the guest
#                        (default: `git remote get-url origin`)
#   --force              skip the confirmation before replacing a running
#                        sandbox
#   --persist-claude-auth / --no-persist-claude-auth
#                        persist Claude Code's login across sessions
#                        (default: on with no COMMAND, off otherwise)
#
# With no COMMAND, opens an interactive shell; with one, runs it
# non-interactively.
#
# Environment:
#   DOCKER_DATA_VOLUME   /var/lib/docker volume name
#                        (default: <session name>-docker-data)
#   DOCKER_DATA_SIZE     size of that volume (default: 20G)
#   CLAUDE_AUTH_VOLUME   ~/.claude volume used by --persist-claude-auth
#                        (default: agent-claude-creds)

# Not -u: macOS ships bash 3.2 (GPLv3 avoidance), where `set -u` treats
# "${secrets[@]}" as unbound whenever the array is still empty - a real
# footgun found by running this script, not a style choice.
set -eo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/agent-runtime.sh
source "$script_dir/lib/agent-runtime.sh"

: "${DOCKER_DATA_SIZE:=20G}"

version="0.4.1" # x-release-please-version
image="ghcr.io/afrossard/container-base:${version}-agent"
name=""
force=0
persist_claude_auth=""
clone_url=""
github_token_env=""
github_token_from_stdin=0
secrets=()
violation_flag=()
memory="4G"
cpus="4"
max_memory="16G"

# "name<TAB>status" lines for sandboxes matching this repo's label, plus
# any exact-name match (covers sandboxes created before labels existed).
# A name in neither status list is reported as "unknown" rather than
# dropped, so a sandbox in some third state is still offered for reuse.
matching_sandboxes() {
  local base="$1" names running stopped name status
  running=$(msb list --running -q 2>/dev/null || true)
  stopped=$(msb list --stopped -q 2>/dev/null || true)

  names=$(
    {
      msb list --label "repo=$base" -q 2>/dev/null || true
      if sandbox_exists "$base"; then printf '%s\n' "$base"; fi
    } | sort -u
  )
  if [ -z "$names" ]; then
    return 0
  fi

  while IFS= read -r name; do
    if [ -z "$name" ]; then
      continue
    fi
    if contains_line "$running" "$name"; then
      status=running
    elif contains_line "$stopped" "$name"; then
      status=stopped
    else
      status=unknown
    fi
    printf '%s\t%s\n' "$name" "$status"
  done <<<"$names"
}

# Confirms before replacing a running sandbox (honours --force). Sets
# $name directly rather than via command substitution, so `exit` here
# still ends the whole script, not just a subshell.
confirm_replace_if_running() {
  local target="$1" offer_new="$2" choice
  sandbox_is_running "$target" || return 0
  [ "$force" = "1" ] && return 0

  if [ ! -t 0 ]; then
    echo "launch-agent-runtime: '$target' is currently running; pass --force to replace it anyway, or 'msb exec $target' to attach to it instead" >&2
    exit 1
  fi

  echo "launch-agent-runtime: '$target' is currently running." >&2
  if [ "$offer_new" = "1" ]; then
    read -r -p "Replace it, start a new one instead, or abort? [r/n/A] " choice
    case "$choice" in
      r | R) ;;
      n | N) name=$(printf '%s-sandbox-%04d' "$(repo_name)" "$((RANDOM % 10000))") ;;
      *)
        echo "launch-agent-runtime: aborted" >&2
        exit 1
        ;;
    esac
  else
    read -r -p "Replace it anyway? [y/N] " choice
    case "$choice" in
      y | Y) ;;
      *)
        echo "launch-agent-runtime: aborted" >&2
        exit 1
        ;;
    esac
  fi
}

# Reuses the one existing sandbox for this repo if there's exactly one,
# asks if there's more than one, mints `<repo>-sandbox` (or
# `-sandbox-NNNN` on collision) if there's none yet.
resolve_name() {
  local base matches count target choice
  base=$(repo_name)
  matches=$(matching_sandboxes "$base")

  if [ -z "$matches" ]; then
    printf '%s-sandbox' "$base"
    return
  fi

  count=$(printf '%s\n' "$matches" | wc -l | tr -d ' ')
  if [ "$count" -eq 1 ]; then
    target=$(printf '%s' "$matches" | cut -f1)
  else
    if [ ! -t 0 ]; then
      echo "launch-agent-runtime: multiple existing sandboxes match '$base' and stdin isn't a terminal to ask; pass --name explicitly:" >&2
      printf '%s\n' "$matches" | awk -F'\t' '{print "  " $1 " (" $2 ")"}' >&2
      exit 1
    fi

    echo "launch-agent-runtime: multiple existing sandboxes match '$base':" >&2
    printf '%s\n' "$matches" | awk -F'\t' '{print NR") " $1 " (" $2 ")"}' >&2
    echo "  n) start a new one" >&2
    read -r -p "Which one? " choice

    if [ "$choice" = "n" ] || [ "$choice" = "N" ]; then
      printf '%s-sandbox-%04d' "$base" "$((RANDOM % 10000))"
      return
    fi
    target=$(printf '%s\n' "$matches" | sed -n "${choice}p" | cut -f1)
  fi

  printf '%s' "$target"
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --name)
      name="$2"
      shift 2
      ;;
    --image)
      image="$2"
      shift 2
      ;;
    --github-token)
      # A literal `-` means "read the token itself, from stdin" - see the
      # read further down for why it happens there and not here. Recorded
      # as intent only, so it needs no lookahead: `-` is an ordinary value
      # as far as the parser is concerned.
      if [ "$2" = "-" ]; then
        github_token_from_stdin=1
        shift 2
        continue
      fi
      # Takes the NAME of a variable, and `--github-token "$GH_TOKEN"` is
      # the obvious slip - it would put the real token in this process's
      # own argv, readable by anyone who can run `ps`, and then hand it to
      # msb as a host to scope against. Neither check may echo what it
      # rejected, since the rejected thing is exactly what must not be
      # printed. A charset check alone would not catch it (real tokens are
      # identifier-shaped: `ghp_...`, `github_pat_...`), so the load-bearing
      # half is the second: a token value is not a variable that is set.
      case "$2" in
        '' | [0-9]* | *[!A-Za-z0-9_]*)
          echo "launch-agent-runtime: --github-token takes the name of a host environment variable (e.g. GH_TOKEN), not a token value" >&2
          exit 1
          ;;
      esac
      if ! printenv "$2" >/dev/null 2>&1; then
        echo "launch-agent-runtime: --github-token names an environment variable that is not set (and it takes the variable's name, not the token value itself)" >&2
        exit 1
      fi
      github_token_env="$2"
      github_token_from_stdin=0
      shift 2
      ;;
    --secret)
      secrets+=(--secret "$2")
      shift 2
      ;;
    --on-secret-violation)
      violation_flag=(--on-secret-violation "$2")
      shift 2
      ;;
    --memory)
      memory="$2"
      shift 2
      ;;
    --cpus)
      cpus="$2"
      shift 2
      ;;
    --max-memory)
      max_memory="$2"
      shift 2
      ;;
    --clone-url)
      clone_url="$2"
      shift 2
      ;;
    --force)
      force=1
      shift
      ;;
    --persist-claude-auth)
      persist_claude_auth=1
      shift
      ;;
    --no-persist-claude-auth)
      persist_claude_auth=0
      shift
      ;;
    --)
      shift
      break
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      echo "launch-agent-runtime: unrecognized argument: $1" >&2
      usage
      exit 1
      ;;
  esac
done

# After the parse loop, so --help still works on a machine with neither.
require_tools msb git

if [ -z "$clone_url" ]; then
  if ! clone_url=$(repo_url); then
    echo "launch-agent-runtime: no 'origin' remote to clone from; pass --clone-url explicitly" >&2
    exit 1
  fi
fi

# No command: default to an interactive zsh, not bash - zsh alone sources
# /etc/zsh/zshenv (ADR-0010), where the dev image's PATH additions live.
tty_flag="--no-tty"
if [ "$#" -eq 0 ]; then
  # Unset $persist_claude_auth means neither flag was given: default it
  # here, before $# changes below, since "no command" is exactly the
  # condition the default depends on.
  : "${persist_claude_auth:=1}"
  set -- zsh
  tty_flag="-t"
fi
: "${persist_claude_auth:=0}"

if [ -z "$name" ]; then
  name=$(resolve_name)
  offer_new=1
else
  offer_new=0
fi

# Applies to an explicit --name too, not just a resolved one - the same
# silent-kill risk exists either way (see the function's own comment for
# why "start a new one" is only offered for a resolved name).
confirm_replace_if_running "$name" "$offer_new"
echo "launch-agent-runtime: session name: $name" >&2

# `--github-token -` reads the token here rather than in the parse loop, so
# that aborting the replace prompt above doesn't mean having typed a secret
# for a launch that never happened.
#
# The name is not free: whatever name is forwarded is the name the guest
# sees (the value is a placeholder, the name is preserved), and `gh` inside
# the guest reads GH_TOKEN or GITHUB_TOKEN and nothing else. Parking a
# prompted token under a tidier internal name would leave `gh` unable to
# find it - the exact failure this flag exists to remove. Exporting here
# touches only this process's own environment, never the caller's shell.
if [ "$github_token_from_stdin" = "1" ]; then
  # Both branches read the same way and guard the same failure, differing
  # only in whether they prompt and hide. `|| true` because read reports
  # EOF in two ordinary situations - input whose last line carries no
  # trailing newline (piping from a password manager), and Ctrl-D at the
  # prompt - and `set -e` would otherwise kill the launch outright: in the
  # tty case without printing anything at all, not even the newline that
  # ends the prompt line. Emptiness is checked below either way, so the
  # deliberate Ctrl-D and the truncated pipe get the same diagnostic.
  if [ -t 0 ]; then
    printf 'GitHub token (input hidden): ' >&2
    IFS= read -rs prompted_token || true
    printf '\n' >&2
  else
    IFS= read -r prompted_token || true
  fi

  # A token piped from a CRLF source arrives with a trailing carriage
  # return, and one pasted by hand often carries surrounding spaces.
  # Neither is part of any GitHub token, and forwarding either produces an
  # "invalid token" inside the guest - the same failure, and the same
  # misdirection, that issue #77 exists to remove. `[:space:]` covers \r.
  prompted_token="${prompted_token#"${prompted_token%%[![:space:]]*}"}"
  prompted_token="${prompted_token%"${prompted_token##*[![:space:]]}"}"

  if [ -z "$prompted_token" ]; then
    echo "launch-agent-runtime: --github-token - read an empty token" >&2
    exit 1
  fi

  export GH_TOKEN="$prompted_token"
  github_token_env="GH_TOKEN"
fi

# Both --github-token paths converge here on a variable name. Why the scope
# names two hosts is in the usage text above, not repeated.
if [ -n "$github_token_env" ]; then
  secrets+=(--secret "${github_token_env}@github.com,api.github.com")

  # Applies the recommendation the --on-secret-violation help text already
  # makes, and only when the caller expressed no preference of their own.
  # Note this tightens the default rather than widening it: quietly adding
  # a host to a secret's scope would hide a security-relevant fact from the
  # command a reader typed, which is why --secret is deliberately left to
  # mean exactly what it says and this flag is a separate, visible opt-in.
  if [ "${#violation_flag[@]}" -eq 0 ]; then
    violation_flag=(--on-secret-violation block-and-log)
  fi
fi

: "${DOCKER_DATA_VOLUME:=${name}-docker-data}"

ensure_volume "$DOCKER_DATA_VOLUME" --kind disk --size "$DOCKER_DATA_SIZE"

claude_mounts=()
if [ "$persist_claude_auth" = "1" ]; then
  : "${CLAUDE_AUTH_VOLUME:=agent-claude-creds}"

  ensure_volume "$CLAUDE_AUTH_VOLUME" --kind dir

  claude_mounts=(
    --mount-named "${CLAUDE_AUTH_VOLUME}:/home/vscode/.claude"
  )
fi

# Pins network egress explicitly (public reachable, LAN denied) instead
# of relying on msb's implicit default, which silently reverts to no
# egress at all the moment any other --net-rule is added below. A
# hostname allowlist was rejected: this workload's own egress isn't
# enumerable (apt, GHCR, npm, GitHub, ...). See ADR-0013.
exec msb run --replace "$tty_flag" --name "$name" --label "repo=$(repo_name)" \
  --memory "$memory" --cpus "$cpus" --max-memory "$max_memory" \
  --net public \
  "${secrets[@]}" \
  "${violation_flag[@]}" \
  --mount-named "${DOCKER_DATA_VOLUME}:/var/lib/docker:kind=disk,size=${DOCKER_DATA_SIZE}" \
  "${claude_mounts[@]}" \
  --script-path "workspace-init:${script_dir}/workspace-init" \
  --env "WORKSPACE_CLONE_URL=${clone_url}" \
  --env "DOTFILES_REPO=${DOTFILES_REPO:-}" \
  --env "PERSIST_CLAUDE_AUTH=${persist_claude_auth}" \
  "$image" -- workspace-init "$@"
