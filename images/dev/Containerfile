FROM debian:trixie-slim

ENV LANG=C.UTF-8

# Only the platform and Node are pinned; every tool floats (ADR-0024).
# The shipped mise system config is the one declaration of what floats and
# where it comes from; this file keeps only the source mise itself comes from.
#
# mise owns Node and every language added later (ADR-0006), installed
# system-wide into a shared data directory (ADR-0008).
ENV MISE_DATA_DIR=/usr/local/share/mise

# The shims go on the image's own PATH, not just the shell startup files
# below, so `sh -c`, `bash -c` and a consumer's `RUN` resolve them too:
# dotfiles-bootstrap is `#!/bin/sh` and calls chezmoi (ADR-0024).
ENV PATH=${MISE_DATA_DIR}/shims:${PATH}

# mise's system config, its lowest config layer (ADR-0020): a bare `node`
# resolves outside any project while a project .mise.toml still wins.
COPY mise/config.toml /etc/mise/config.toml

# mise, then everything else from the shipped config.
#
# mise comes from its extrepo source, and is installed here because
# `mise bootstrap` cannot install itself. curl stays for the Homebrew
# installer below.
#
# `mise bootstrap --yes` then adds the declared apt sources (Anthropic's,
# key fingerprint checked), installs the declared apt packages and the tools
# (baking the Node pin and the floating tools into the shared data
# directory), and runs the `bootstrap` task, whose full upgrade brings the
# base layer current. It runs as root here, so the data directory is
# chowned to vscode after (ADR-0008), and root's caches and state - gh's
# telemetry device id among them - are dropped rather than baked.
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        extrepo \
    && extrepo enable mise \
    && apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends mise \
    && mkdir -p "$MISE_DATA_DIR" \
    && mise bootstrap --yes \
    && chown -R 1000:1000 "$MISE_DATA_DIR" \
    && rm -rf /var/lib/apt/lists/* /root/.cache /root/.local

# sudo and zsh, which the edits below need, come from the shipped config's
# [bootstrap.packages] installed above.
#
# mise runs system-wide in shims mode (ADR-0008): shims prepended to sudo's
# secure_path, the only one sudo reads, and to PATH again in the shell
# startup files, since Debian's /etc/profile rewrites PATH for login shells.
# MISE_GLOBAL_CONFIG_FILE stays unset - the shipped config is mise's system
# config (ADR-0020), not its global one, so per-project pins still win.
RUN sed -i \
        "s|^Defaults\tsecure_path=\"|Defaults\tsecure_path=\"${MISE_DATA_DIR}/shims:|" \
        /etc/sudoers \
    && shims_line="export PATH=\"${MISE_DATA_DIR}/shims:\$PATH\"" \
    && printf '\n# mise shims (ADR-0008)\n%s\n' "$shims_line" >> /etc/zsh/zshenv \
    && printf '# mise shims (ADR-0008)\n%s\n' "$shims_line" > /etc/profile.d/mise-shims.sh

# Homebrew, for parity with the Mac and the operator's own ad-hoc formulae;
# the image declares none (ADR-0024). Its installer refuses root unless it
# sees /.dockerenv, which a BuildKit `RUN` step doesn't create, so it is
# faked around the install. Prefix chowned to vscode afterward. shellenv
# goes in /etc/zsh/zshenv so non-interactive shells get it too (ADR-0010).
# `shellenv zsh`, not bare `shellenv`: brew otherwise picks the flavour from
# the RUN step's sh and omits the fpath line its completions need (issue #210).
ENV HOMEBREW_PREFIX=/home/linuxbrew/.linuxbrew
ENV HOMEBREW_NO_ANALYTICS=1
ENV NONINTERACTIVE=1

RUN touch /.dockerenv \
    && /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" \
    && chown -R 1000:1000 "$HOMEBREW_PREFIX" \
    && rm -f /.dockerenv \
    && rm -rf /root/.cache \
    && printf '\n# Homebrew shellenv (ADR-0010)\n%s\n' \
        "$("$HOMEBREW_PREFIX/bin/brew" shellenv zsh)" >> /etc/zsh/zshenv

# The starship binary ships but no `starship init` line is written: shell
# ergonomics are a personal-dotfiles concern (ADR-0010).

# dotfiles-bootstrap is the one thing every consumer calls (ADR-0007): it
# reads the dotfiles repo from the environment, never bakes one in (ADR-0001).
COPY dotfiles-bootstrap /usr/local/bin/dotfiles-bootstrap
RUN chmod 0755 /usr/local/bin/dotfiles-bootstrap

# docker-prune-credsstore is opt-in, not universal: only a consumer on
# docker-outside-of-docker calls it, from postStartCommand beside
# dotfiles-bootstrap, to drop a host-only credsStore (issue #205). It leans
# on the jq the common-utils feature installs, pinned by test/dev/dev.bats.
COPY docker-prune-credsstore /usr/local/bin/docker-prune-credsstore
RUN chmod 0755 /usr/local/bin/docker-prune-credsstore

# vscode, not root, is this image's default (issue #17): a plain `docker run`
# would otherwise land as root, which Claude Code rejects for
# `--dangerously-skip-permissions`. vscode doesn't exist yet here - the
# common-utils feature creates it - but the devcontainer CLI reads this
# final USER, carries it through the feature layers as
# `_DEV_CONTAINERS_IMAGE_USER`, and restores it last. Confirmed by build
# and inspect, contra ADR-0014's similar claim. A Containerfile building
# FROM this image inherits vscode and must `USER root` before `apt-get`.
USER vscode
