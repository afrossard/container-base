FROM debian:trixie-slim

ENV LANG=C.UTF-8

# uv owns the Python interpreter (ADR-0006). COPY --from avoids the shell
# installer's $HOME writes.
COPY --from=ghcr.io/astral-sh/uv:0.12.10 /uv /uvx /bin/

# mise owns Node and every language added later (ADR-0006), from apt rather
# than the `mise.run` script, which targets $HOME.
#
# zsh and sudo are installed here so /etc/zsh/zshenv and /etc/sudoers exist
# for the appends below; the common-utils feature leaves them alone.
ENV MISE_DATA_DIR=/usr/local/share/mise

# System-level default Node pin (ADR-0020): mise reads /etc/mise/config.toml
# as its lowest config layer, so a bare `node` resolves outside any project
# while a project .mise.toml still wins. Read by the `mise install` below.
COPY mise/config.toml /etc/mise/config.toml

# ca-certificates, curl and git are for the Homebrew installer below, in
# this layer to share one apt-get with the base tooling.
#
# `mise install` with no arguments bakes the system-config pin (ADR-0020)
# into the shared vscode-owned data directory. chown runs after, as root.
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        extrepo \
        git \
        sudo \
        zsh \
    && extrepo enable mise \
    && apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends mise \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p "$MISE_DATA_DIR" \
    && mise install \
    && chown -R 1000:1000 "$MISE_DATA_DIR"

# mise runs system-wide in shims mode (ADR-0008): shims on PATH for every
# shell and prepended to sudo's secure_path, the only one sudo reads.
# MISE_GLOBAL_CONFIG_FILE stays unset - the baked pin is mise's system
# config (ADR-0020), not its global one, so per-project pins still win.
RUN sed -i \
        "s|^Defaults\tsecure_path=\"|Defaults\tsecure_path=\"${MISE_DATA_DIR}/shims:|" \
        /etc/sudoers \
    && shims_line="export PATH=\"${MISE_DATA_DIR}/shims:\$PATH\"" \
    && printf '\n# mise shims (ADR-0008)\n%s\n' "$shims_line" >> /etc/zsh/zshenv \
    && printf '# mise shims (ADR-0008)\n%s\n' "$shims_line" > /etc/profile.d/mise-shims.sh

# Homebrew, for parity with the Mac. Its installer refuses root unless it
# sees /.dockerenv, which a BuildKit `RUN` step doesn't create, so it is
# faked around the install. Prefix chowned to vscode afterward. shellenv
# goes in /etc/zsh/zshenv so non-interactive shells get it too (ADR-0010).
ENV HOMEBREW_PREFIX=/home/linuxbrew/.linuxbrew
ENV HOMEBREW_NO_ANALYTICS=1
ENV NONINTERACTIVE=1

RUN touch /.dockerenv \
    && /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" \
    && "$HOMEBREW_PREFIX/bin/brew" install dive starship \
    && chown -R 1000:1000 "$HOMEBREW_PREFIX" \
    && rm -f /.dockerenv \
    && rm -rf /root/.cache/Homebrew \
    && printf '\n# Homebrew shellenv (ADR-0010)\n%s\n' \
        "$("$HOMEBREW_PREFIX/bin/brew" shellenv)" >> /etc/zsh/zshenv

# The starship binary ships but no `starship init` line is written: shell
# ergonomics are a personal-dotfiles concern (ADR-0010).

# chezmoi system-wide at /usr/local/bin (ADR-0005, ADR-0009). -b overrides
# the installer's ~/.local default, which would prompt with no TTY.
RUN curl -fsSL get.chezmoi.io | sh -s -- -b /usr/local/bin

# dotfiles-bootstrap is the one thing every consumer calls (ADR-0007): it
# reads the dotfiles repo from the environment, never bakes one in (ADR-0001).
COPY dotfiles-bootstrap /usr/local/bin/dotfiles-bootstrap
RUN chmod 0755 /usr/local/bin/dotfiles-bootstrap

# gh, vim, bubblewrap ship in Debian's repository (issue #7). gnupg is here
# to verify Claude Code's signing key below. bubblewrap is required by
# Claude Code's sandbox mode and was missing from common-utils (ADR-0005).
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        bubblewrap \
        gh \
        gnupg \
        vim \
    && rm -rf /var/lib/apt/lists/*

# dive has no Debian package; it rides the same brew install as starship.

# Claude Code from its official signed apt repository, `stable` channel: the
# native installer writes into ~/.local, the one directory this image must
# leave alone, and `claude-code` is a Homebrew cask (unsupported on Linux).
# apt installs don't auto-update, correct for a versioned base image. The
# key's fingerprint is checked against Anthropic's published one first.
RUN install -d -m 0755 /etc/apt/keyrings \
    && curl -fsSL https://downloads.claude.ai/keys/claude-code.asc \
        -o /etc/apt/keyrings/claude-code.asc \
    && fingerprint="$(gpg --show-keys --with-colons --with-fingerprint /etc/apt/keyrings/claude-code.asc \
        | awk -F: '$1 == "fpr" { print $10; exit }')" \
    && [ "$fingerprint" = "31DDDE24DDFAB679F42D7BD2BAA929FF1A7ECACE" ] \
    && echo "deb [signed-by=/etc/apt/keyrings/claude-code.asc] https://downloads.claude.ai/claude-code/apt/stable stable main" \
        > /etc/apt/sources.list.d/claude-code.list \
    && apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends claude-code \
    && rm -rf /var/lib/apt/lists/* /root/.gnupg

# vscode, not root, is this image's default (issue #17): a plain `docker run`
# would otherwise land as root, which Claude Code rejects for
# `--dangerously-skip-permissions`. vscode doesn't exist yet here - the
# common-utils feature creates it - but the devcontainer CLI reads this
# final USER, carries it through the feature layers as
# `_DEV_CONTAINERS_IMAGE_USER`, and restores it last. Confirmed by build
# and inspect, contra ADR-0014's similar claim. A Containerfile building
# FROM this image inherits vscode and must `USER root` before `apt-get`.
USER vscode
