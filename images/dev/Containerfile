FROM debian:trixie-slim

ENV LANG=C.UTF-8

# uv owns the Python interpreter (ADR-0006). The shell installer targets
# $HOME and appends to ~/.zshrc; the documented COPY --from form avoids both.
COPY --from=ghcr.io/astral-sh/uv:0.12.5 /uv /uvx /bin/

# mise owns Node and every language added later (ADR-0006), installed from
# its own apt repository rather than the `mise.run` script, which also
# targets $HOME.
#
# zsh and sudo are installed here, ahead of the common-utils feature that
# configures them further, so /etc/zsh/zshenv and /etc/sudoers already exist
# for the appends below. The feature detects both already present and
# leaves this layer's edits alone.
ENV MISE_DATA_DIR=/usr/local/share/mise

# ca-certificates, curl and git are runtime requirements of the Homebrew
# installer below, not of mise; they're installed in this same layer to
# share one apt-get update/install with the rest of the base tooling.
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        extrepo \
        git \
        sudo \
        zsh \
    && extrepo enable mise \
    && apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends mise \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p "$MISE_DATA_DIR" \
    && chown -R 1000:1000 "$MISE_DATA_DIR"

# mise runs system-wide, in shims mode (ADR-0008): the data directory above
# is shared and vscode-owned, the shims directory is on PATH for every
# shell, and it is prepended to sudo's secure_path, the only one of the
# three sudo actually reads. MISE_GLOBAL_CONFIG_FILE is deliberately unset:
# version pinning is per project, and a global config is the baked fallback
# ADR-0006 rules out.
RUN sed -i \
        "s|^Defaults\tsecure_path=\"|Defaults\tsecure_path=\"${MISE_DATA_DIR}/shims:|" \
        /etc/sudoers \
    && shims_line="export PATH=\"${MISE_DATA_DIR}/shims:\$PATH\"" \
    && printf '\n# mise shims (ADR-0008)\n%s\n' "$shims_line" >> /etc/zsh/zshenv \
    && printf '# mise shims (ADR-0008)\n%s\n' "$shims_line" > /etc/profile.d/mise-shims.sh

# Homebrew, for parity with the Mac. Its installer refuses to run as root
# unless it detects a container; that check looks for /.dockerenv,
# which classic `docker run` sets up but a BuildKit `RUN` step does not, so
# it is created and removed around the install. The prefix is chowned to
# the eventual vscode uid/gid afterward, same as mise's data directory
# above, so `brew install` needs no sudo once the common-utils feature
# creates that user. shellenv goes in /etc/zsh/zshenv, never a file under
# $HOME, so non-interactive shells get it too (ADR-0010).
ENV HOMEBREW_PREFIX=/home/linuxbrew/.linuxbrew
ENV HOMEBREW_NO_ANALYTICS=1
ENV NONINTERACTIVE=1

RUN touch /.dockerenv \
    && /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" \
    && "$HOMEBREW_PREFIX/bin/brew" install dive starship \
    && chown -R 1000:1000 "$HOMEBREW_PREFIX" \
    && rm -f /.dockerenv \
    && rm -rf /root/.cache/Homebrew \
    && printf '\n# Homebrew shellenv (ADR-0010)\n%s\n' \
        "$("$HOMEBREW_PREFIX/bin/brew" shellenv)" >> /etc/zsh/zshenv

# The starship binary ships, but shell ergonomics are a personal-dotfiles
# concern (ADR-0010): no `starship init` line is written anywhere in the
# image, so a developer without dotfiles gets the binary on PATH and the
# default shell prompt.

# chezmoi installed system-wide at /usr/local/bin (ADR-0005, ADR-0009): its
# generated installer targets ~/.local when chezmoi is not already on PATH,
# which creates ~/.local, which chezmoi then prompts about with no TTY.
# -b overrides that default so the trap never has a chance to trigger.
RUN curl -fsSL get.chezmoi.io | sh -s -- -b /usr/local/bin

# dotfiles-bootstrap is the one thing every consumer calls (ADR-0007): it
# takes the dotfiles repository from the environment and never bakes one
# in, since a shared image carries no one's configuration (ADR-0001).
COPY dotfiles-bootstrap /usr/local/bin/dotfiles-bootstrap
RUN chmod 0755 /usr/local/bin/dotfiles-bootstrap

# The remaining tools every consumer previously installed by hand (issue
# #7): gh, vim and bubblewrap all ship in Debian's own repository. gnupg is
# installed here too, not because any of those three need it, but to verify
# Claude Code's signing key below. bubblewrap is not optional - Claude
# Code's sandbox mode needs it, and it was missing despite appearing in the
# common-utils package list (ADR-0005).
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        bubblewrap \
        gh \
        gnupg \
        vim \
    && rm -rf /var/lib/apt/lists/*

# dive has no Debian package. It ships as a Homebrew formula rather than a
# hand-rolled GitHub-release install, so it rides the same brew install
# above as starship - see that block's comment for why root can run it and
# why the prefix ends up vscode-owned.

# Claude Code installs from its official signed apt repository, `stable`
# channel: the native installer manages ~/.local/bin/claude into
# ~/.local/share/claude/versions/, writing into the one directory this
# image must leave alone, and Homebrew can't stand in either, since
# `claude-code` is a cask and Homebrew on Linux doesn't support casks. apt
# installations don't auto-update, which is correct behaviour for a
# versioned base image - a rebuild refreshes it. The downloaded key's
# fingerprint is checked against the one Anthropic publishes before
# anything is installed with it.
RUN install -d -m 0755 /etc/apt/keyrings \
    && curl -fsSL https://downloads.claude.ai/keys/claude-code.asc \
        -o /etc/apt/keyrings/claude-code.asc \
    && fingerprint="$(gpg --show-keys --with-colons --with-fingerprint /etc/apt/keyrings/claude-code.asc \
        | awk -F: '$1 == "fpr" { print $10; exit }')" \
    && [ "$fingerprint" = "31DDDE24DDFAB679F42D7BD2BAA929FF1A7ECACE" ] \
    && echo "deb [signed-by=/etc/apt/keyrings/claude-code.asc] https://downloads.claude.ai/claude-code/apt/stable stable main" \
        > /etc/apt/sources.list.d/claude-code.list \
    && apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends claude-code \
    && rm -rf /var/lib/apt/lists/* /root/.gnupg

# vscode, not root, is this image's default (issue #17): a plain `docker run`
# or an agent using the image directly, rather than through `devcontainer
# up`, would otherwise land as root, which is the state Claude Code rejects
# `--dangerously-skip-permissions` in. vscode itself doesn't exist yet at
# this point in the build - the common-utils feature below creates it - so
# this is a forward reference. It resolves correctly: the devcontainer CLI
# reads this Containerfile's own final USER before applying any feature,
# carries it through the feature-install layers (which still run as root,
# since installers like this one need it) as the generated wrapper
# Dockerfile's `_DEV_CONTAINERS_IMAGE_USER` build arg, and restores it as
# the very last instruction. Confirmed on a scratch devcontainer.json/
# Containerfile pair built with `devcontainer build` and inspected via
# `docker inspect --format '{{.Config.User}}'`, not assumed - ADR-0014's
# similar claim, that a build-time USER instruction doesn't survive feature
# application, does not hold here. A Containerfile that builds FROM this
# image to add tools inherits vscode as its default user too, and must
# `USER root` before `apt-get` - the standard devcontainer pattern, but a
# behavior change for anyone already building on top.
USER vscode
