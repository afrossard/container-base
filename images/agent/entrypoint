#!/bin/sh
# First-boot entry for the agent runtime (ADR-0014). Converges the runtime
# via agent-bringup, then hands the launcher's command to the non-root
# working user in the workspace directory.
#
# `msb start` re-runs none of this on a resume (issue #144); the launcher
# re-runs agent-bringup over `msb exec` instead.
set -eu

runtime_user=vscode

# No default command (ADR-0013): a missing command is an error, not a
# fallback to `sleep infinity`. Checked first so it fails fast.
if [ "$#" -eq 0 ]; then
  echo "agent-entrypoint: no command given; the agent runtime has no default command" >&2
  exit 1
fi

# Converge: docker daemon, dotfiles bootstrap, workspace clone.
agent-bringup || echo "agent-entrypoint: continuing despite the failures above, so there is still a shell to debug in (ADR-0026)" >&2

# Hand off from inside the workspace, as the working user; fall back to the
# home directory if no workspace URL was configured or the clone failed.
repo_dir="/home/$runtime_user"
if [ -n "${WORKSPACE_CLONE_URL:-}" ]; then
  workspace_dir="/home/$runtime_user/git/$(basename "$WORKSPACE_CLONE_URL" .git)"
  if [ -d "$workspace_dir" ]; then
    repo_dir="$workspace_dir"
  else
    echo "agent-entrypoint: WARNING: $workspace_dir is missing; starting in $repo_dir instead" >&2
  fi
fi
cd "$repo_dir"

exec runuser -u "$runtime_user" -- "$@"
