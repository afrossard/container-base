# The agent runtime is a published image variant (ADR-0014), built on the
# same published dev image every consumer builds on, pinned here the same
# way .devcontainer/Containerfile pins it so Renovate owns the bump.
FROM ghcr.io/afrossard/container-base:0.0.7-dev

# The base image now defaults to vscode, not root (issue #17). This image
# stays root throughout its own build and ships with no final USER of its
# own, deliberately: dockerd needs root to start, and the entrypoint below
# is what performs the actual drop to vscode at runtime, via runuser, once
# the daemon is up - never via a baked-in USER instruction (ADR-0014).
USER root

# The docker-in-docker devcontainer feature (images/agent/devcontainer.json)
# installs the engine itself - docker-ce, containerd, buildx, and iptables,
# including its own iptables-legacy/nft alternative selection - so this
# Containerfile only adds tini, which the feature doesn't carry and which
# the entrypoint below needs as PID 1 to reap dockerd's orphaned children.
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends tini \
    && rm -rf /var/lib/apt/lists/*

# The engine's version is a property of this image, not something a session
# may change (ADR-0014: the image is the guest). Without this hold, a plain
# `apt-get upgrade` inside a live guest breaks `docker run` for the rest of
# the boot (issue #66): dpkg replaces containerd-shim-runc-v2 on disk, but
# there is no service manager here to restart the containerd docker-init.sh
# already started, so the old daemon then forks the new shim and fails to
# parse its start response - surfacing as the unrecognizable "failed to
# create TTRPC connection: unsupported protocol: Yunix". Renovate owns the
# bump at build time instead. The cost is that a session cannot pick up a
# docker security update in place, which is the right trade for a runtime
# that is discarded at the end of the session.
#
# These three are the whole apt-managed engine: the feature installs buildx
# and compose as downloaded binaries under /usr/libexec/docker/cli-plugins,
# not as packages (`dpkg -S` finds no owner), so naming the plugin packages
# here would only make the build fail on an uninstalled package. The
# `docker-compose-plugin` package that is installed is a client plugin the
# downloaded binary already shadows, and cannot affect the daemon.
RUN apt-mark hold docker-ce docker-ce-cli containerd.io

COPY entrypoint /usr/local/bin/agent-entrypoint
RUN chmod 0755 /usr/local/bin/agent-entrypoint

# tini as PID 1 reaps dockerd's children; the entrypoint script delegates
# dockerd's own startup to the feature's docker-init.sh and drops the given
# command to a non-root user (docs/research/0022's "drop the sleep infinity
# fallback" still applies - no default command).
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/agent-entrypoint"]
