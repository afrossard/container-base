# The agent runtime is a published image variant (ADR-0014) built on the
# published dev image. release-please owns this pin (ADR-0018).
# x-release-please-start-version
ARG BASE_VERSION=1.0.0
# x-release-please-end
FROM ghcr.io/afrossard/container-base:${BASE_VERSION}-dev

# The base image defaults to vscode (issue #17). This image stays root
# through its build and ships no final USER: dockerd needs root, and the
# entrypoint drops to vscode at runtime via runuser (ADR-0014).
USER root

# The docker-in-docker feature (images/agent/devcontainer.json) installs the
# engine; this Containerfile only adds tini, which the entrypoint needs as
# PID 1 to reap dockerd's orphaned children.
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends tini \
    && rm -rf /var/lib/apt/lists/*

# agent-entrypoint runs on the first boot; agent-bringup is its convergence
# step (docker daemon, dotfiles, workspace clone), re-run by the launcher
# over `msb exec` on every later attach since `msb start` re-runs nothing
# (issue #144). ensure-workspace is agent-bringup's clone-or-reuse step,
# split out so it is testable on its own.
COPY entrypoint /usr/local/bin/agent-entrypoint
COPY bringup /usr/local/bin/agent-bringup
COPY ensure-workspace /usr/local/bin/ensure-workspace
RUN chmod 0755 /usr/local/bin/agent-entrypoint /usr/local/bin/agent-bringup /usr/local/bin/ensure-workspace

# tini as PID 1 reaps dockerd's children; the entrypoint delegates dockerd
# startup to the feature's docker-init.sh and drops the command to non-root.
# No default command (docs/research/0022).
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/agent-entrypoint"]
