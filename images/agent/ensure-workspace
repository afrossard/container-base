#!/bin/sh
# Ensures this repo's workspace clone is present in the runtime user's home.
# Clones on the first boot; a no-op once the clone is there, so it is safe
# to re-run on every attach of a long-lived runtime (issue #144).
#
# No --depth: /code-review's `git merge-base` needs full history. No --ref:
# a ref flag would default to the host's current branch and fail at boot
# whenever that branch is unpushed (ADR-0015).
set -eu

# The launcher always sets this; a bare `docker run` of the image does not,
# and then there is nothing to clone (mirrors dotfiles-bootstrap with
# DOTFILES_REPO unset).
if [ -z "${WORKSPACE_CLONE_URL:-}" ]; then
  echo "ensure-workspace: WORKSPACE_CLONE_URL unset, nothing to clone"
  exit 0
fi

repo_dir="$HOME/$(basename "$WORKSPACE_CLONE_URL" .git)"

if [ -e "$repo_dir/.git" ]; then
  echo "ensure-workspace: $repo_dir already present, leaving it as is"
  exit 0
fi

git clone "$WORKSPACE_CLONE_URL" "$repo_dir"
